# Copy to .env and fill in your own key. Never commit .env.
# No key → degraded fallback (every ticket escalates to human, no classification);
# set a provider key to enable the LLM structured-output path in analyze.

# Provider: openai (default) or gemini
LLM_PROVIDER=openai

# OpenAI path (gpt-6-luna default, override with OPENAI_MODEL)
OPENAI_API_KEY=openai-api-key
OPENAI_MODEL=gpt-6-luna

# Gemini path (gemini-3.1-flash-lite default, override with GEMINI_MODEL)
GOOGLE_API_KEY=google-api-key
GEMINI_MODEL=gemini-3.1-flash-lite

# Optional: LangSmith tracing
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=
